{
	# E-mail para os avisos de expiração de certificado do Let's Encrypt
	# (encaminha pro Gmail via Cloudflare Email Routing).
	email contato@appnosso.com

	# Para TESTAR sem gastar o limite do Let's Encrypt, descomente a linha abaixo
	# (emite certificado "de mentira"; o navegador vai reclamar — é esperado):
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory
}

appnosso.com {
	root * /srv
	encode zstd gzip

	# Deixa /privacidade servir /privacidade.html, /vs-honeydue -> /vs-honeydue.html etc.
	# (os links internos já usam .html explícito; isto é só um extra.)
	try_files {path} {path}.html {path}/index.html
	file_server

	header {
		# HTTPS obrigatório por 1 ano. Depois de validar que está tudo ok você
		# pode reforçar com:  "max-age=31536000; includeSubDomains; preload"
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output stdout
		format console
	}
}

# Outros projetos no mesmo servidor. Cada um sobe o próprio container na rede
# Docker "edge" (declarada no compose.yaml) e este Caddy só faz o HTTPS e o
# encaminhamento. Ficam aqui no git para não se perderem a cada rebuild.
rifou.appnosso.com {
	reverse_proxy rifou-web:3000
	header Strict-Transport-Security "max-age=31536000"
}

conferirbolao.com.br {
	reverse_proxy bolao-web:80
	header Strict-Transport-Security "max-age=31536000"
}

www.conferirbolao.com.br {
	redir https://conferirbolao.com.br{uri} permanent
}

# Histórias da Navegação (repo joabsilva/site-navegacao): container navegacao-web na rede edge.
# Os mapas não passam por aqui: ficam no Cloudflare R2 (mapas.historiasdanavegacao.com.br).
historiasdanavegacao.com.br {
	reverse_proxy navegacao-web:80
	header Strict-Transport-Security "max-age=31536000"
}

www.historiasdanavegacao.com.br, historiasdanavegacao.com, www.historiasdanavegacao.com {
	redir https://historiasdanavegacao.com.br{uri} permanent
}

# OPCIONAL — redireciona www.appnosso.com -> appnosso.com.
# Habilite só DEPOIS de criar o registro DNS de "www" apontando pro servidor,
# senão o Caddy não consegue emitir o certificado e trava a emissão.
# www.appnosso.com {
# 	redir https://appnosso.com{uri} permanent
# }
